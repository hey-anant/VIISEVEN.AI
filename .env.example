# Google Gemini API Key (PRIMARY — fast, free)
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (FALLBACK)
# Get a key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Convex Configuration
NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-convex-deployment.convex.site
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_AUTH_CLIENT_ID_KEY=your_google_auth_client_id

# Optional: Express Server Configuration
# PORT=5000
# NEXT_PUBLIC_SERVER_URL=http://localhost:5000
