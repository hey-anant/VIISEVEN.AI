# Convex Configuration
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Deploy key for automatic Convex functions deploy in CI/CD (Vercel)
# Generate from Convex dashboard: Settings -> Deploy Keys
CONVEX_DEPLOY_KEY=your_convex_deploy_key_here

# Google Gemini API Key (SERVER ONLY - PRIVATE)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (SERVER ONLY - PRIVATE)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google OAuth Client ID (PUBLIC)
NEXT_PUBLIC_GOOGLE_AUTH_CLIENT_ID_KEY=your_google_oauth_client_id.apps.googleusercontent.com

# GitHub OAuth App Configuration
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
